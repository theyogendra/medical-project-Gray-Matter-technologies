{
    "name": "@medical-app/backend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "start": "node dist/main",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "prisma:generate": "prisma generate --schema=../../database/prisma/schema.prisma --config=../../database/prisma/prisma.config.ts",
        "prisma:migrate": "prisma migrate dev --schema=../../database/prisma/schema.prisma --config=../../database/prisma/prisma.config.ts --name init",
        "prisma:seed": "ts-node ../../database/prisma/seed.ts"
    },
    "dependencies": {
        "@nestjs/common": "^11.2.8",
        "@nestjs/core": "^11.2.8",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.4.8",
        "@prisma/client": "^7.10.1",
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^17.4.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.6.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.2.8",
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.1",
        "@types/passport-jwt": "^4.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.1",
        "prisma": "^7.10.1",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    }
}