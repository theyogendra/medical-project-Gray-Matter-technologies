# Copy this file to backend/.env and fill in values on YOUR laptop.
# .env is ignored by git — never commit real values.

# Local development uses a SQLite file. Production will use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ipjos
DATABASE_URL=sqlite:///./ipj_os_dev.db

# Used by E0 to sign login tokens later.
SECRET_KEY=change-me

# Which web addresses may call the API (comma separated). * = anything (dev only).
ALLOWED_ORIGINS=*

# Filled in later by E10 (test-mode keys only).
PAYMENT_TEST_KEY=
